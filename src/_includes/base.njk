<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ doctitle | safe }}</title>
  <meta name="description" content="{{ description | safe }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,340..600;1,9..144,340..600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400..600;1,8..60,400..600&family=Archivo:wght@500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/main.css">
  <noscript><style>[data-reveal]{opacity:1;transform:none}</style></noscript>
{% if headExtra %}  {{ headExtra | safe }}
{% endif %}  <link rel="canonical" href="https://www.refinishing.org{{ canonical }}">
  <meta property="og:type" content="{{ ogType }}">
  <meta property="og:title" content="{{ ogTitle | safe }}">
  <meta property="og:description" content="{{ ogDescription | safe }}">
  <meta property="og:url" content="https://www.refinishing.org{{ canonical }}">
  <meta property="og:image" content="{{ ogImage | safe }}">
  <meta name="twitter:card" content="summary_large_image">
{% if schemas %}  {{ schemas | safe }}
{% endif %}  <link rel="icon" type="image/png" href="/assets/img/favicon.png">
  <script async src="https://www.googletagmanager.com/gtag/js?id=AW-1036488597"></script>
  <script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','AW-1036488597');gtag('config','G-H890QYMC8J');</script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  {% include "header.njk" %}
  <main id="main">{{ content | safe }}</main>

  {% include "footer.njk" %}
  <script src="/assets/js/main.js" defer></script>
</body>
</html>
